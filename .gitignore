# .gitignore
# Files that should NEVER be pushed to GitHub

# API keys and secrets
.env

# Virtual environment
venv/
.venv/

# ChromaDB vector store (large binary files)
chroma_db/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Pytest cache
.pytest_cache/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.log
